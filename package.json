{
  "name": "mbta-live",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:jobs": "node scripts/build-jobs.mjs",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:replay": "vitest run --project replay",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "job:collect": "tsx --conditions=react-server src/jobs/collect.ts",
    "job:sync-static": "tsx --conditions=react-server src/jobs/sync-static.ts",
    "job:aggregate": "tsx --conditions=react-server src/jobs/aggregate.ts",
    "fixtures:record": "tsx --conditions=react-server scripts/record-fixtures.ts",
    "fixtures:cases": "tsx scripts/build-case-fixtures.ts",
    "fixtures:record-sequence": "tsx --conditions=react-server scripts/record-sequence.ts",
    "infra:fmt": "terraform fmt -recursive -check infra/terraform",
    "infra:validate": "bash scripts/infra-validate.sh"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "date-fns": "^4.4.0",
    "next": "^16.4.4",
    "pg": "^8.23.1",
    "prisma": "7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.4",
    "fast-check": "^4.10.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "prisma",
      "@prisma/engines"
    ],
    "overrides": {
      "lodash": ">=4.18.0",
      "minimatch@<11.0.1": ">=11.0.1"
    }
  }
}
