# ローカル開発用。コピーして .env.local を作る（.env.local はコミットしない）

# ローカルの接続文字列（docker compose の db）
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mbta_live
# 結合テスト用 DB
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mbta_live_test
# E2E 用 DB（pnpm test:e2e が作り直す）
E2E_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mbta_live_e2e

# Cloud Run 用（DATABASE_URL がないときに使う。パスワードは Secret Manager から注入）
# INSTANCE_CONNECTION_NAME=project:us-east4:instance
# DB_NAME=mbta_live
# DB_USER=mbta_live
# DB_PASSWORD=

# MBTA V3 API
MBTA_API_BASE_URL=https://api-v3.mbta.com
# 任意。設定すると x-api-key ヘッダーで送る
MBTA_API_KEY=
# 1 で MBTA API の代わりに tests/fixtures/mbta/ のフィクスチャを使う
MBTA_FIXTURE_MODE=1

# local / dev / prod。画面の環境バッジにだけ使う
APP_ENV=local
# 生データの保持日数（dev 3 / prod 28）
RAW_RETENTION_DAYS=28
